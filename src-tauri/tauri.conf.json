{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lowarc-studio",
  "mainBinaryName": "lowarc-studio",
  "identifier": "com.lowarc.studio",
  "build": {
    "frontendDist": "../src",
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/prepare-bundle.ps1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LowArc Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src 'self' http://127.0.0.1:*; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../plugins", "runtime-helpers"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

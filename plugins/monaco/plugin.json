{
  "name": "Monaco Editor",
  "version": "0.1.0",
  "description": "Code editor for opened files, powered by Monaco (vendored from the monaco-editor npm package, see MONACO_LICENSE).",
  "contributes": {
    "viewers": [
      {
        "id": "main",
        "title": "Monaco",
        "entry": "index.html",
        "extensions": [
          ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx",
          ".json", ".jsonc",
          ".html", ".htm", ".css", ".scss", ".less",
          ".md", ".markdown",
          ".py", ".rs", ".go", ".java",
          ".c", ".h", ".cpp", ".hpp", ".cc", ".cs",
          ".php", ".rb", ".sh", ".bash",
          ".yml", ".yaml", ".xml", ".sql",
          ".lua", ".swift", ".kt", ".dart",
          ".ps1", ".bat", ".ini",
          ".uc",
          ".txt"
        ]
      }
    ]
  },
  "settings": [
    { "key": "fontSize", "label": "Font size", "type": "number", "placeholder": "14" },
    { "key": "tabSize", "label": "Tab size", "type": "number", "placeholder": "4" },
    { "key": "insertSpaces", "label": "Insert spaces on Tab", "type": "checkbox", "hint": "Off inserts an actual tab character instead." },
    { "key": "wordWrap", "label": "Word wrap", "type": "checkbox" },
    { "key": "minimap", "label": "Minimap", "type": "checkbox" },
    { "key": "lineNumbers", "label": "Line numbers", "type": "checkbox" }
  ]
}
